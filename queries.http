  "query": {
    "bool": {
      "filter": [
        { "term": { "dostupno": true } },
        { "range": { "ocjena": { "gte": 7 } } }
      ],
      "must": [
        { "match": { "opis": "svemir" } }
      ]
    }
  }
}

