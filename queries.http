ZAVRSNI Zadatak
Kreirenje Indeksa
PUT http://localhost:9200/filmovi
Content-Type: application/json

{
  "settings": {
    "analysis": {
      "analyzer": {
        "hrvatski_analyzer": {
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "naslov": { "type": "text", "analyzer": "hrvatski_analyzer" },
      "redatelj": { "type": "keyword" },
      "zanr": { "type": "keyword" },
      "opis": { "type": "text", "analyzer": "hrvatski_analyzer" },
      "godina": { "type": "integer" },
      "ocjena": { "type": "double" },
      "dostupno": { "type": "boolean" }
    }
  }
}
